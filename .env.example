# ---------------------------------------------------------------------------
# Koreb Homes Backend — Environment Variables
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# Database (PostgreSQL with PostGIS extension enabled)
# Example: postgresql://user:password@localhost:5432/koreb_homes?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koreb_homes?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Google Sign-In ("Continue with Google")
# Create an OAuth 2.0 Client ID in the Google Cloud Console. For the token-based
# flow used here, the frontend runs the Google SDK and posts the ID token to
# POST /auth/google; the backend verifies it against this same client ID.
# GOOGLE_CLIENT_SECRET is only needed if you later add the redirect-based flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP (phone verification)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS Provider — swappable. "console" just logs codes to the server console,
# useful for local development before a real SMS account is set up.
SMS_PROVIDER=console
# When you plug in a real provider (e.g. a local aggregator or Twilio), add
# its credentials here, e.g.:
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=KorebHomes

# Payments — Chapa (https://chapa.co)
PAYMENT_PROVIDER=chapa
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=replace-with-webhook-signing-secret
CHAPA_CALLBACK_URL=https://api.korebhomes.com/api/v1/payments/webhook
CHAPA_RETURN_URL=https://korebhomes.com/payment/complete

# Fayda (eSignet / OpenID Connect) — national ID verification
# Not yet integrated; placeholders reserved so the module can be wired in later.
FAYDA_ISSUER_URL=
FAYDA_CLIENT_ID=
FAYDA_CLIENT_SECRET=
FAYDA_REDIRECT_URI=

# File storage for listing photos
# "local" stores under ./uploads for development and serves them at /uploads.
# The SAME path is used for writing and for static serving, so they can't drift.
# Swap to "s3"-compatible object storage (DigitalOcean Spaces, etc.) before production.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=

# Listing photo limits
MAX_PHOTOS_PER_LISTING=10
MAX_PHOTO_UPLOAD_SIZE_MB=8

# Listing inactivity / auto-unpublish job
LISTING_INACTIVITY_DAYS=30
LISTING_GRACE_PERIOD_DAYS=7
LISTING_NUDGE_DAYS_BEFORE=5,2

# Default monetization settings (overridable via Admin Panel -> Pricing & Settings)
DEFAULT_OWNER_LISTING_FEE_ETB=250
DEFAULT_AGENT_LISTING_FEE_ETB=250
DEFAULT_PENALTY_MULTIPLIER=1.5
